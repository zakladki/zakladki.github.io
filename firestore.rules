rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Користувачі та їхні збережені закладки
    // Кожен авторизований користувач має доступ виключно до свого документа
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Замовлення на додавання сайтів / рекламу
    // Створити заявку може будь-який відвідувач сайту
    // Читати та редагувати статус може адміністратор (або авторизований автор заявки)
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Заборона доступу до всіх інших неоголошених колекцій
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
